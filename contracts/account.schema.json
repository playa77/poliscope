        "mechanism_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Mechanism Ref",
          "type": "string"
        },
        "reservation_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reservation Id"
        },
        "source_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Id"
        },
        "source_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Source Refs",
          "type": "array"
        }
