{
  "$defs": {
    "AccountBatch": {
      "additionalProperties": false,
      "properties": {
        "accounts": {
          "items": {
            "$ref": "#/$defs/AccountDefinition"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Accounts",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/AccountClaim"
          },
          "maxItems": 1000,
          "title": "Claims",
          "type": "array"
        },
        "contract_version": {
          "const": 1,
          "title": "Contract Version",
          "type": "integer"
        },
        "postings": {
          "items": {
            "$ref": "#/$defs/AccountPosting"
          },
          "maxItems": 10000,
          "title": "Postings",
          "type": "array"
        },
        "reservations": {
          "items": {
            "$ref": "#/$defs/AccountReservation"
          },
          "maxItems": 1000,
          "title": "Reservations",
          "type": "array"
        },
        "subtotals": {
          "items": {
            "$ref": "#/$defs/AccountSubtotal"
          },
          "maxItems": 1000,
          "title": "Subtotals",
          "type": "array"
        }
      },
      "required": [
        "contract_version",
        "accounts",
        "postings",
        "claims",
        "reservations",
        "subtotals"
      ],
      "title": "AccountBatch",
      "type": "object"
    },
    "AccountClaim": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Account Id",
          "type": "string"
        },
        "claimant_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Claimant Id",
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "requested": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "title": "Requested",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "account_id",
        "claimant_id",
        "requested",
        "source_refs"
      ],
      "title": "AccountClaim",
      "type": "object"
    },
    "AccountDefinition": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": 1,
          "title": "Contract Version",
          "type": "integer"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "invariant": {
          "enum": [
            "physical",
            "budget",
            "ledger"
          ],
          "title": "Invariant",
          "type": "string"
        },
        "kind": {
          "enum": [
            "stock",
            "flow",
            "capacity"
          ],
          "title": "Kind",
          "type": "string"
        },
        "maximum": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "title": "Maximum",
          "type": "string"
        },
        "opening": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "title": "Opening",
          "type": "string"
        },
        "period_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Period Id"
        },
        "quantum": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "title": "Quantum",
          "type": "string"
        },
        "scope_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Source Refs",
          "type": "array"
        },
        "unit_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Unit Id",
          "type": "string"
        }
      },
      "required": [
        "contract_version",
        "id",
        "kind",
        "unit_id",
        "scope_id",
        "period_id",
        "invariant",
        "quantum",
        "maximum",
        "opening",
        "source_refs"
      ],
      "title": "AccountDefinition",
      "type": "object"
    },
    "AccountEvaluation": {
      "additionalProperties": false,
      "properties": {
        "accounts": {
          "items": {
            "$ref": "#/$defs/AccountResult"
          },
          "maxItems": 1000,
          "title": "Accounts",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimResult"
          },
          "maxItems": 1000,
