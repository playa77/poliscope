    "DrawSpec": {
      "additionalProperties": false,
      "properties": {
        "assumption_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Assumption Refs",
          "type": "array"
        },
        "day": {
          "maximum": 9007199254740991,
          "minimum": 0,
