{
  "$defs": {
    "Bernoulli": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Denominator",
          "type": "integer"
        },
        "kind": {
          "const": "bernoulli",
          "title": "Kind",
          "type": "string"
        },
        "numerator": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "numerator",
        "denominator"
      ],
      "title": "Bernoulli",
      "type": "object"
    },
    "BoundaryOutcome": {
      "additionalProperties": false,
      "properties": {
        "boundary_contract": {
          "const": 1,
          "title": "Boundary Contract",
          "type": "integer"
        },
        "boundary_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Boundary Digest",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/ExperimentContext"
        },
        "day": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Day",
          "type": "integer"
        },
        "sequence": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "boundary_contract",
        "context",
        "sequence",
        "day",
        "boundary_digest"
      ],
      "title": "BoundaryOutcome",
      "type": "object"
    },
    "Categorical": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "categorical",
          "title": "Kind",
          "type": "string"
        },
        "outcomes": {
          "items": {
            "$ref": "#/$defs/WeightedValue"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Outcomes",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "outcomes"
      ],
      "title": "Categorical",
      "type": "object"
    },
    "ComparisonRow": {
      "additionalProperties": false,
      "properties": {
        "delta": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "label": "#/$defs/LabelValue",
                  "quantity": "#/$defs/QuantityValue",
                  "reference": "#/$defs/ReferenceValue",
                  "unknown": "#/$defs/UnknownValue"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/QuantityValue"
                },
                {
                  "$ref": "#/$defs/UnknownValue"
                },
                {
                  "$ref": "#/$defs/LabelValue"
                },
                {
                  "$ref": "#/$defs/ReferenceValue"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Delta"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "left": {
          "$ref": "#/$defs/ComparisonValue"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Reasons",
          "type": "array"
        },
        "right": {
          "$ref": "#/$defs/ComparisonValue"
        }
      },
      "required": [
        "id",
        "left",
        "right",
        "delta",
        "reasons"
      ],
      "title": "ComparisonRow",
      "type": "object"
    },
    "ComparisonValue": {
      "additionalProperties": false,
      "properties": {
        "definition": {
          "anyOf": [
            {
