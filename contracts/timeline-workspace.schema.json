    "QuantityValue": {
      "additionalProperties": false,
      "properties": {
        "denominator_scope_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
