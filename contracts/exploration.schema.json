    },
    "MembershipWeight": {
      "additionalProperties": false,
      "description": "Explicit weight or partition; never implicit equal or duplicate membership.",
      "properties": {
        "kind": {
          "const": "weight",
          "title": "Kind",
          "type": "string"
        },
        "weight": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "title": "Weight",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "weight"
      ],
      "title": "MembershipWeight",
      "type": "object"
    },
