            {
              "$ref": "#/$defs/ScopeDTO"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartitionValueDTO"
            },
            {
              "type": "null"
            }
          ]
        }
