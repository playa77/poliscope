{
  "$defs": {
    "BranchState": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/RevisionContext"
        },
        "forked_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "redo": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Redo",
          "type": "array"
        },
        "revision_contract": {
          "const": 1,
          "title": "Revision Contract",
          "type": "integer"
        },
        "sequence": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "revision_contract",
        "context",
        "name",
        "sequence",
        "redo",
        "forked_from"
      ],
      "title": "BranchState",
      "type": "object"
    },
    "EffectiveTime": {
      "additionalProperties": false,
      "description": "Simulation time; no wall-clock timestamp participates in this identity.",
      "properties": {
        "calendar_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Calendar Id",
          "type": "string"
        },
        "tick": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        }
      },
      "required": [
        "tick",
        "calendar_id"
      ],
      "title": "EffectiveTime",
      "type": "object"
    },
    "EntityDTO": {
      "additionalProperties": false,
      "properties": {
        "entity_kind": {
          "enum": [
            "civilization",
            "location",
            "population_cohort",
            "household_arrangement",
            "community_arrangement",
            "institution",
            "asset",
            "network",
            "resource",
            "service",
            "account",
            "external_interface",
            "decision",
            "event"
          ],
          "title": "Entity Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/WorldProvenance"
        }
      },
      "required": [
        "id",
        "entity_kind",
        "label",
        "provenance"
      ],
      "title": "EntityDTO",
      "type": "object"
    },
    "EntityEdit": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "$ref": "#/$defs/EntityDTO"
        },
        "kind": {
          "const": "entity",
          "title": "Kind",
          "type": "string"
        },
        "population_role": {
          "anyOf": [
            {
              "enum": [
                "fixed_input",
                "dynamic_state",
                "solved_capacity_bound"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population Role"
        }
      },
      "required": [
        "kind",
        "entity"
      ],
      "title": "EntityEdit",
      "type": "object"
    },
    "ExplorationEdit": {
      "additionalProperties": false,
      "properties": {
        "change": {
          "discriminator": {
            "mapping": {
              "entity": "#/$defs/EntityEdit",
              "relationship": "#/$defs/RelationshipEdit",
              "value": "#/$defs/ValueEdit"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/EntityEdit"
            },
            {
              "$ref": "#/$defs/RelationshipEdit"
            },
            {
              "$ref": "#/$defs/ValueEdit"
            }
          ],
          "title": "Change"
        },
        "context": {
          "$ref": "#/$defs/RevisionContext"
        },
        "scope_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        }
      },
      "required": [
        "context",
        "scope_id",
        "change"
      ],
      "title": "ExplorationEdit",
      "type": "object"
    },
    "ExplorationPage": {
      "additionalProperties": false,
      "properties": {
        "effective_time": {
          "$ref": "#/$defs/EffectiveTime"
        },
        "exploration_contract": {
          "const": 1,
          "title": "Exploration Contract",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ExplorationRow"
          },
          "maxItems": 25,
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "query": {
          "$ref": "#/$defs/ExplorationQuery"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "versions": {
          "$ref": "#/$defs/WorldVersions"
        }
      },
      "required": [
        "exploration_contract",
        "query",
        "versions",
        "effective_time",
        "items",
        "total",
        "next_cursor"
      ],
      "title": "ExplorationPage",
      "type": "object"
    },
    "ExplorationPreview": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "maxLength": 16384,
          "title": "After",
          "type": "string"
        },
        "before": {
          "maxLength": 16384,
          "title": "Before",
          "type": "string"
        },
        "candidate_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Digest",
          "type": "string"
        },
        "coverage": {
          "maxLength": 4096,
          "title": "Coverage",
          "type": "string"
        },
        "edit": {
          "$ref": "#/$defs/ExplorationEdit"
        },
        "exploration_contract": {
          "const": 1,
          "title": "Exploration Contract",
          "type": "integer"
        }
      },
      "required": [
        "exploration_contract",
        "edit",
        "candidate_digest",
        "before",
        "after",
        "coverage"
      ],
      "title": "ExplorationPreview",
      "type": "object"
    },
    "ExplorationQuery": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/RevisionContext"
        },
        "cursor": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "identity": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity"
        },
        "projection": {
          "default": "all",
          "enum": [
            "geography",
            "membership",
            "authority",
            "networks",
            "all"
          ],
          "title": "Projection",
          "type": "string"
        },
        "scope_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        }
      },
      "required": [
        "context",
        "scope_id"
      ],
      "title": "ExplorationQuery",
      "type": "object"
    },
    "ExplorationRow": {
      "additionalProperties": false,
