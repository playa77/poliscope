{
  "$defs": {
    "ConstantNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "constant",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "value_type": {
          "discriminator": {
            "mapping": {
              "label": "#/$defs/LabelType",
              "quantity": "#/$defs/QuantityType",
              "reference": "#/$defs/ReferenceType"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/QuantityType"
            },
            {
              "$ref": "#/$defs/LabelType"
            },
            {
              "$ref": "#/$defs/ReferenceType"
            }
          ],
          "title": "Value Type"
        }
      },
      "required": [
        "kind",
        "id",
        "value",
        "value_type"
      ],
      "title": "ConstantNode",
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "Identity",
      "type": "object"
    },
    "InputNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "input_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Input Id",
          "type": "string"
        },
        "kind": {
          "const": "input",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "input_id"
      ],
      "title": "InputNode",
      "type": "object"
    },
    "LabelType": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "label",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LabelType",
      "type": "object"
    },
    "OperatorNode": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Arguments",
          "type": "array"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "operator",
          "title": "Kind",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "kind",
        "id",
        "operator",
        "arguments"
      ],
      "title": "OperatorNode",
      "type": "object"
    },
    "QuantityType": {
      "additionalProperties": false,
      "properties": {
        "denominator_scope_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Denominator Scope Id"
        },
        "kind": {
          "const": "quantity",
          "title": "Kind",
          "type": "string"
        },
        "time_basis_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Time Basis Id"
        },
        "unit_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Unit Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "unit_id",
        "time_basis_id",
        "denominator_scope_id"
      ],
      "title": "QuantityType",
      "type": "object"
    },
    "ReferenceType": {
      "additionalProperties": false,
      "properties": {
        "entity_kind": {
          "enum": [
            "civilization",
            "location",
            "population_cohort",
            "household_arrangement",
            "community_arrangement",
            "institution",
            "asset",
            "network",
            "resource",
            "service",
            "account",
            "external_interface",
            "decision",
            "event"
          ],
          "title": "Entity Kind",
          "type": "string"
        },
        "kind": {
          "const": "reference",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "entity_kind"
      ],
      "title": "ReferenceType",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": 1,
      "title": "Contract Version",
      "type": "integer"
    },
    "id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "nodes": {
      "items": {
        "discriminator": {
          "mapping": {
            "constant": "#/$defs/ConstantNode",
            "input": "#/$defs/InputNode",
            "operator": "#/$defs/OperatorNode"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/InputNode"
          },
          {
            "$ref": "#/$defs/ConstantNode"
          },
          {
            "$ref": "#/$defs/OperatorNode"
          }
        ]
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "outputs": {
      "additionalProperties": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxProperties": 100,
      "propertyNames": {
        "maxLength": 256,
        "minLength": 1
      },
      "title": "Outputs",
      "type": "object"
    },
    "state": {
      "additionalProperties": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxProperties": 100,
      "propertyNames": {
        "maxLength": 256,
        "minLength": 1
      },
      "title": "State",
      "type": "object"
    },
    "version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "id",
    "version",
    "nodes",
    "outputs",
    "state"
  ],
  "title": "ExpressionGraph",
  "type": "object"
}
