          "type": "array"
        }
      },
      "required": [
        "day",
        "mechanism_ids",
        "event_ids",
        "adoption_ids"
      ],
      "title": "ScheduledBoundary",
      "type": "object"
    },
    "TimelinePlan": {
      "additionalProperties": false,
      "properties": {
        "adoptions": {
          "items": {
            "$ref": "#/$defs/PolicyAdoption"
          },
          "maxItems": 1000,
          "title": "Adoptions",
          "type": "array"
        },
        "calendar": {
          "$ref": "#/$defs/Calendar"
        },
        "contract_version": {
          "const": 1,
