        "opening_revision",
        "opening_day",
        "schedules",
        "events",
        "adoptions"
      ],
      "title": "TimelinePlan",
      "type": "object"
    },
    "UnknownValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unknown",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason"
