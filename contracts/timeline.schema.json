  "anyOf": [
    {
      "$ref": "#/$defs/TimelinePlan"
    },
    {
      "$ref": "#/$defs/ScheduledBoundary"
    },
    {
      "$ref": "#/$defs/BoundaryChanges"
    }
  ]
