{
  "$defs": {
    "ArchivedFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_./-]+$",
          "title": "Path",
          "type": "string"
        },
        "text": {
          "maxLength": 131072,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "path",
        "text"
      ],
      "title": "ArchivedFile",
      "type": "object"
    },
    "ArchivedSource": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "excerpt_file": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_./-]+$",
          "title": "Excerpt File",
          "type": "string"
        },
        "license_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "License Digest",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "required": [
        "reference",
        "commit",
        "excerpt_file",
        "license_digest"
      ],
      "title": "ArchivedSource",
      "type": "object"
    },
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/AssumptionRef"
