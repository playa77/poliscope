        "definition_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Definition Version",
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "authored",
            "imported",
            "player_input",
            "ai_proposed",
            "derived"
          ],
          "title": "Origin",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "scope_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
