        "validity_limits": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Validity Limits",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "validity_limits"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "AssumptionRef": {
