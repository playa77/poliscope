        "parent_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "pattern": "^[a-z][a-z0-9_.-]*:[a-zA-Z0-9_./-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Ref"
        },
        "source_decision_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Decision Id"
        },
        "source_refs": {
          "items": {
            "maxLength": 256,
            "pattern": "^[a-z][a-z0-9_.-]*:[a-zA-Z0-9_./-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Source Refs",
          "type": "array"
        },
        "supersedes_refs": {
          "items": {
            "maxLength": 256,
            "pattern": "^[a-z][a-z0-9_.-]*:[a-zA-Z0-9_./-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Supersedes Refs",
          "type": "array"
        },
        "variable_refs": {
          "items": {
            "maxLength": 256,
            "pattern": "^[a-z][a-z0-9_.-]*:[a-zA-Z0-9_./-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Variable Refs",
          "type": "array"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
