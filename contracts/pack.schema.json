        "mechanism_refs": {
          "items": {
            "maxLength": 256,
            "pattern": "^[a-z][a-z0-9_.-]*:[a-zA-Z0-9_./-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Mechanism Refs",
          "type": "array"
        },
        "modeling": {
          "enum": [
            "numerical",
            "procedural",
            "qualitative",
            "partial",
            "unsupported"
          ],
          "title": "Modeling",
          "type": "string"
        },
        "origin": {
          "enum": [
            "authored",
            "imported",
            "player_proposed",
            "ai_proposed"
          ],
          "title": "Origin",
          "type": "string"
        },
        "original_text": {
          "maxLength": 131072,
          "minLength": 1,
          "title": "Original Text",
          "type": "string"
        },
        "parameter": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterDeclaration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
