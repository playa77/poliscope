          "maxItems": 100,
          "minItems": 1,
          "title": "Engine Versions",
          "type": "array"
        },
        "files": {
          "maxProperties": 500,
          "patternProperties": {
            "^[a-zA-Z0-9_./-]+$": {
              "pattern": "^sha256:[0-9a-f]{64}$",
