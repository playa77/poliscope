        "version",
        "kind",
        "parent_ref",
        "original_text",
        "source_decision_id",
        "source_refs",
        "assumption_refs",
        "supersedes_refs",
        "mechanism_refs",
        "variable_refs",
        "origin",
        "modeling",
        "evidence",
        "historical_status"
