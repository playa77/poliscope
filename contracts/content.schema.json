        "path": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_./-]+$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "digest"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Catalog": {
