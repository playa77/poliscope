{
  "$defs": {
    "AccountProducer": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Account Id",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/PortRef"
        }
      },
      "required": [
        "producer",
        "account_id"
      ],
      "title": "AccountProducer",
      "type": "object"
    },
    "ClaimBinding": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Account Id",
          "type": "string"
        },
        "allocation_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Allocation Id",
          "type": "string"
        },
        "claim_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "instance_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Instance Id",
          "type": "string"
        }
      },
      "required": [
        "instance_id",
        "claim_id",
        "account_id",
        "allocation_id"
      ],
      "title": "ClaimBinding",
      "type": "object"
    },
    "ContextRelationship": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "institutional",
            "documentary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "relationship_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Relationship Ref",
          "type": "string"
        },
        "source_instance_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Instance Id",
          "type": "string"
        },
        "target_instance_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Target Instance Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source_instance_id",
        "target_instance_id",
        "relationship_ref"
      ],
      "title": "ContextRelationship",
      "type": "object"
    },
    "FixedInput": {
      "additionalProperties": false,
      "properties": {
        "consumer": {
          "$ref": "#/$defs/PortRef"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "label": "#/$defs/LabelValue",
              "quantity": "#/$defs/QuantityValue",
              "reference": "#/$defs/ReferenceValue",
              "unknown": "#/$defs/UnknownValue"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/QuantityValue"
            },
            {
              "$ref": "#/$defs/UnknownValue"
            },
            {
              "$ref": "#/$defs/LabelValue"
            },
            {
              "$ref": "#/$defs/ReferenceValue"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "consumer",
        "value"
      ],
      "title": "FixedInput",
      "type": "object"
    },
    "LabelValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "label",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "maxLength": 4096,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "LabelValue",
      "type": "object"
    },
    "MechanismInstance": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mechanism_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Mechanism Id",
          "type": "string"
        },
        "mechanism_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Mechanism Version",
          "type": "string"
        },
        "scope_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "mechanism_id",
        "mechanism_version",
        "scope_id",
        "entity_id"
      ],
      "title": "MechanismInstance",
      "type": "object"
    },
    "NumericalBinding": {
      "additionalProperties": false,
      "properties": {
        "consumer": {
          "$ref": "#/$defs/PortRef"
        },
        "producer": {
          "$ref": "#/$defs/PortRef"
        }
      },
      "required": [
        "producer",
        "consumer"
      ],
      "title": "NumericalBinding",
      "type": "object"
    },
    "PortRef": {
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Instance Id",
          "type": "string"
        },
        "port_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Port Id",
          "type": "string"
        }
      },
      "required": [
        "instance_id",
        "port_id"
      ],
      "title": "PortRef",
      "type": "object"
    },
    "QuantityValue": {
      "additionalProperties": false,
      "properties": {
        "denominator_scope_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Denominator Scope Id"
        },
        "kind": {
          "const": "quantity",
          "title": "Kind",
          "type": "string"
        },
        "time_basis_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Time Basis Id"
        },
        "unit_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Unit Id",
          "type": "string"
        },
        "value": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value",
        "unit_id",
        "time_basis_id",
        "denominator_scope_id"
      ],
      "title": "QuantityValue",
      "type": "object"
    },
    "ReferenceValue": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "kind": {
          "const": "reference",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "entity_id"
      ],
      "title": "ReferenceValue",
      "type": "object"
    },
    "UnknownValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unknown",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "title": "UnknownValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "account_producers": {
      "items": {
        "$ref": "#/$defs/AccountProducer"
      },
      "maxItems": 1000,
      "title": "Account Producers",
      "type": "array"
    },
    "bindings": {
      "items": {
        "$ref": "#/$defs/NumericalBinding"
      },
      "maxItems": 1000,
      "title": "Bindings",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/ClaimBinding"
      },
      "maxItems": 1000,
      "title": "Claims",
      "type": "array"
    },
    "contract_version": {
      "const": 1,
      "title": "Contract Version",
      "type": "integer"
    },
    "fixed_inputs": {
      "items": {
        "$ref": "#/$defs/FixedInput"
      },
      "maxItems": 1000,
      "title": "Fixed Inputs",
      "type": "array"
    },
    "instances": {
      "items": {
        "$ref": "#/$defs/MechanismInstance"
      },
      "maxItems": 100,
      "title": "Instances",
      "type": "array"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/ContextRelationship"
      },
      "maxItems": 1000,
      "title": "Relationships",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "instances",
    "bindings",
    "fixed_inputs",
    "claims",
    "account_producers",
    "relationships"
  ],
  "title": "DependencyRequest",
  "type": "object"
}
