          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "mechanism": {
          "$ref": "#/$defs/Identity"
        },
        "parameter_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Parameter Id",
          "type": "string"
        },
        "scope_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "label": "#/$defs/LabelValue",
              "quantity": "#/$defs/QuantityValue",
              "reference": "#/$defs/ReferenceValue",
              "unknown": "#/$defs/UnknownValue"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/QuantityValue"
            },
            {
              "$ref": "#/$defs/UnknownValue"
