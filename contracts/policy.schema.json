    "ResolutionRule": {
      "additionalProperties": false,
      "description": "Host-selected, versioned rule; content metadata cannot register itself.\n\nExact participants prevent a rule silently extending to newly added policies.\nAuthority and scope identify the institution authorizing this resolution.",
      "properties": {
        "authority_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Authority Id",
          "type": "string"
        },
        "contract_version": {
          "const": 1,
          "title": "Contract Version",
          "type": "integer"
        },
        "entity_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "operation": {
          "enum": [
            "select",
            "sum",
            "bounds"
          ],
          "title": "Operation",
          "type": "string"
        },
        "parameter_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Parameter Id",
          "type": "string"
        },
        "participant_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
