        "contract_version",
        "identity",
        "authority_id",
        "scope_id",
        "entity_id",
        "parameter_id",
        "participant_ids",
        "operation",
        "selected_id",
        "source_refs"
      ],
      "title": "ResolutionRule",
      "type": "object"
    },
    "UnknownValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unknown",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "title": "UnknownValue",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/PolicyBinding"
    },
    {
      "$ref": "#/$defs/ResolutionRule"
    },
    {
      "$ref": "#/$defs/PolicyEvaluation"
    }
  ]
