        },
        "definition_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Definition Version",
          "type": "string"
        },
        "diagnostic": {
          "enum": [
            "neutral",
            "within_named_thresholds",
            "flagged",
            "unavailable"
          ],
          "title": "Diagnostic",
          "type": "string"
        },
        "effective_time": {
          "$ref": "#/$defs/EffectiveTime"
        },
        "indicator_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Indicator Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "scope_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
