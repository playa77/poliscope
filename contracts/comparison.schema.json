        },
        "status": {
          "enum": [
            "known",
            "partial",
            "missing_input",
            "unmodeled",
            "conflict",
            "solver_failure",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "trace_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Trace Refs",
          "type": "array"
        },
        "value": {
          "discriminator": {
            "mapping": {
