        },
        "can_undo": {
          "title": "Can Undo",
          "type": "boolean"
        },
        "comparison_contract": {
          "const": 1,
          "title": "Comparison Contract",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/LineageRow"
          },
          "maxItems": 10,
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "query": {
          "$ref": "#/$defs/LineageQuery"
        }
      },
      "required": [
        "comparison_contract",
        "query",
        "can_undo",
        "branch",
        "items",
        "next_cursor"
      ],
      "title": "LineagePage",
      "type": "object"
    },
    "LineageQuery": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/RevisionContext"
        },
        "cursor": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cursor"
        }
      },
      "required": [
        "context",
        "cursor"
      ],
      "title": "LineageQuery",
      "type": "object"
    },
    "LineageRow": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "items": {
            "$ref": "#/$defs/ChoiceSummary"
          },
          "maxItems": 100,
          "title": "Alternatives",
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/RevisionContext"
        },
        "parent_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        },
        "rationale": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrivateReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected Id"
        }
      },
      "required": [
        "context",
        "parent_id",
        "selected_id",
        "alternatives",
        "rationale"
      ],
      "title": "LineageRow",
      "type": "object"
    },
    "MeasurementInput": {
      "additionalProperties": false,
      "properties": {
        "node": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
