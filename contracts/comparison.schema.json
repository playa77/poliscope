{
  "$defs": {
    "BranchState": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/RevisionContext"
        },
        "forked_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "redo": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Redo",
          "type": "array"
        },
        "revision_contract": {
          "const": 1,
          "title": "Revision Contract",
          "type": "integer"
        },
        "sequence": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "revision_contract",
        "context",
        "name",
        "sequence",
        "redo",
        "forked_from"
      ],
      "title": "BranchState",
      "type": "object"
    },
    "ChoiceSummary": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "wording": {
          "items": {
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Wording",
          "type": "array"
        }
      },
      "required": [
        "id",
        "wording"
      ],
      "title": "ChoiceSummary",
      "type": "object"
    },
    "ComparePage": {
      "additionalProperties": false,
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/$defs/DesignDifference"
          },
          "maxItems": 10,
          "title": "Changes",
          "type": "array"
        },
        "comparison_contract": {
          "const": 1,
          "title": "Comparison Contract",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ComparisonRow"
          },
          "maxItems": 10,
          "title": "Items",
          "type": "array"
        },
        "left_evidence": {
          "enum": [
            "complete",
            "unavailable"
          ],
          "title": "Left Evidence",
          "type": "string"
        },
        "left_versions": {
          "$ref": "#/$defs/WorldVersions"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "query": {
          "$ref": "#/$defs/CompareQuery"
        },
        "right_evidence": {
          "enum": [
            "complete",
            "unavailable"
          ],
          "title": "Right Evidence",
          "type": "string"
        },
        "right_versions": {
          "$ref": "#/$defs/WorldVersions"
        }
      },
      "required": [
        "comparison_contract",
        "query",
        "left_evidence",
        "right_evidence",
        "left_versions",
        "right_versions",
        "items",
        "changes",
        "next_cursor"
      ],
      "title": "ComparePage",
      "type": "object"
    },
    "CompareQuery": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/RevisionContext"
        },
        "cursor": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cursor"
        },
        "other": {
          "$ref": "#/$defs/RevisionContext"
        }
      },
      "required": [
        "context",
        "other",
        "cursor"
      ],
      "title": "CompareQuery",
      "type": "object"
    },
    "ComparisonRow": {
      "additionalProperties": false,
      "properties": {
        "delta": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "label": "#/$defs/LabelValue",
                  "quantity": "#/$defs/QuantityValue",
                  "reference": "#/$defs/ReferenceValue",
                  "unknown": "#/$defs/UnknownValue"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/QuantityValue"
                },
                {
                  "$ref": "#/$defs/UnknownValue"
                },
                {
                  "$ref": "#/$defs/LabelValue"
                },
                {
                  "$ref": "#/$defs/ReferenceValue"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Delta"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "left": {
          "$ref": "#/$defs/ComparisonValue"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Reasons",
          "type": "array"
        },
        "right": {
          "$ref": "#/$defs/ComparisonValue"
        }
      },
      "required": [
        "id",
        "left",
        "right",
        "delta",
        "reasons"
      ],
      "title": "ComparisonRow",
      "type": "object"
    },
    "ComparisonValue": {
      "additionalProperties": false,
      "properties": {
        "definition": {
          "anyOf": [
            {
              "$ref": "#/$defs/IndicatorDefinition"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/MeasurementObservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "enum": [
            "retained_evidence",
            "unavailable"
          ],
          "title": "Origin",
          "type": "string"
        },
        "trace_state": {
          "enum": [
            "complete",
            "incomplete",
            "unavailable"
          ],
          "title": "Trace State",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "definition",
        "observation",
        "trace_state"
      ],
      "title": "ComparisonValue",
      "type": "object"
    },
    "DesignDifference": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "After"
        },
        "before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "value",
            "assumption",
            "policy",
            "goal",
            "reference"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "before",
        "after"
      ],
      "title": "DesignDifference",
      "type": "object"
    },
    "DiagnosticRule": {
      "additionalProperties": false,
      "properties": {
        "assumption_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Assumption Refs",
          "type": "array"
        },
        "category": {
          "enum": [
            "physical_shortage",
            "selected_policy_breach",
            "institutional_gap",
            "uncertainty"
          ],
          "title": "Category",
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "interpretation": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Interpretation",
          "type": "string"
        },
        "name": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "operation": {
          "enum": [
            "lt",
            "le",
            "eq",
            "ne",
            "ge",
            "gt"
          ],
          "title": "Operation",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Source Refs",
          "type": "array"
        },
        "threshold": {
          "$ref": "#/$defs/QuantityValue"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "operation",
        "threshold",
        "category",
        "interpretation",
        "source_refs",
        "assumption_refs"
      ],
      "title": "DiagnosticRule",
      "type": "object"
    },
    "EffectiveTime": {
      "additionalProperties": false,
      "description": "Simulation time; no wall-clock timestamp participates in this identity.",
      "properties": {
        "calendar_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Calendar Id",
          "type": "string"
        },
        "tick": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        }
      },
      "required": [
        "tick",
        "calendar_id"
      ],
      "title": "EffectiveTime",
      "type": "object"
    },
    "HistoryAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "undo",
            "redo",
            "fork",
            "rename",
            "restore"
          ],
          "title": "Action",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/RevisionContext"
        },
        "expected_sequence": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expected Sequence",
          "type": "integer"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "target_revision_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Revision Id"
        }
      },
      "required": [
        "context",
        "expected_sequence",
        "action",
        "target_revision_id",
        "name"
      ],
      "title": "HistoryAction",
      "type": "object"
    },
    "IndicatorDefinition": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "const": "same_scope",
          "title": "Aggregation",
          "type": "string"
        },
        "assumption_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Assumption Refs",
          "type": "array"
        },
        "coverage": {
          "enum": [
            "known",
            "partial",
            "missing_input",
            "unmodeled",
            "conflict",
            "solver_failure",
            "not_applicable"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "denominator_scope_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Denominator Scope Id"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/DiagnosticRule"
          },
          "maxItems": 100,
          "title": "Diagnostics",
          "type": "array"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/MeasurementInput"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "interpretation": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Interpretation",
          "type": "string"
        },
        "name": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "procedure": {
          "enum": [
            "identity",
            "sum",
            "mean",
            "minimum",
            "maximum",
            "difference",
            "ratio"
          ],
          "title": "Procedure",
          "type": "string"
        },
        "scope_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Source Refs",
          "type": "array"
        },
        "time_basis_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Time Basis Id"
        },
        "unit_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Unit Id",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "procedure",
        "inputs",
        "unit_id",
        "scope_id",
        "aggregation",
        "time_basis_id",
        "denominator_scope_id",
        "coverage",
        "interpretation",
        "source_refs",
        "assumption_refs",
        "diagnostics"
      ],
      "title": "IndicatorDefinition",
      "type": "object"
    },
    "LabelValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "label",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "maxLength": 131072,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "LabelValue",
      "type": "object"
    },
    "LineagePage": {
