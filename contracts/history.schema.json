{
  "$defs": {
    "AssumptionPage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/AssumptionRef"
          },
          "maxItems": 100,
          "title": "Items",
          "type": "array"
        },
        "kind": {
          "const": "assumptions",
          "title": "Kind",
          "type": "string"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        }
      },
      "required": [
        "next_cursor",
        "kind",
        "items"
      ],
      "title": "AssumptionPage",
      "type": "object"
    },
    "AssumptionRef": {
      "additionalProperties": false,
      "properties": {
        "definition_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Definition Id",
          "type": "string"
        },
        "definition_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Definition Version",
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "authored",
            "imported",
            "player_input",
            "ai_proposed",
            "derived"
          ],
          "title": "Origin",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "scope_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Source Refs",
          "type": "array"
        },
        "uncertainty_definition_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uncertainty Definition Ref"
        },
        "uncertainty_form": {
          "enum": [
            "point",
            "bounded_range",
            "distribution",
            "qualitative",
            "unspecified"
          ],
          "title": "Uncertainty Form",
          "type": "string"
        }
      },
      "required": [
        "id",
        "scope_id",
        "definition_id",
        "definition_version",
        "origin",
        "uncertainty_form",
        "uncertainty_definition_ref",
        "rationale",
        "source_refs"
      ],
      "title": "AssumptionRef",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "covered_scope_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Covered Scope Refs",
          "type": "array"
        },
        "excluded_scope_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Excluded Scope Refs",
          "type": "array"
        },
        "explanation": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "missing_input_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Missing Input Refs",
          "type": "array"
        },
        "status": {
          "enum": [
            "known",
            "partial",
            "missing_input",
            "unmodeled",
            "conflict",
            "solver_failure",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "explanation",
        "covered_scope_refs",
        "excluded_scope_refs",
        "missing_input_refs"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "EffectiveTime": {
      "additionalProperties": false,
      "description": "Simulation time; no wall-clock timestamp participates in this identity.",
      "properties": {
        "calendar_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Calendar Id",
          "type": "string"
        },
        "tick": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        }
      },
      "required": [
        "tick",
        "calendar_id"
      ],
      "title": "EffectiveTime",
      "type": "object"
    },
    "EvaluationOutput": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "effective_time": {
          "$ref": "#/$defs/EffectiveTime"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceLinks"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "indicator_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Indicator Id",
          "type": "string"
        },
        "observation": {
          "discriminator": {
            "mapping": {
              "conflict": "#/$defs/UnavailableObservation",
              "known": "#/$defs/KnownObservation",
              "missing_input": "#/$defs/UnavailableObservation",
              "not_applicable": "#/$defs/UnavailableObservation",
              "partial": "#/$defs/PartialObservation",
              "solver_failure": "#/$defs/UnavailableObservation",
              "unmodeled": "#/$defs/UnavailableObservation"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/KnownObservation"
            },
            {
              "$ref": "#/$defs/PartialObservation"
            },
            {
              "$ref": "#/$defs/UnavailableObservation"
            }
          ],
          "title": "Observation"
        },
        "scope_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "indicator_id",
        "scope_id",
        "effective_time",
        "observation",
        "coverage",
        "evidence"
      ],
      "title": "EvaluationOutput",
      "type": "object"
    },
    "EvaluationSummary": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/RevisionContext"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "effective_time": {
          "$ref": "#/$defs/EffectiveTime"
        },
        "evidence_schema": {
          "const": 1,
          "title": "Evidence Schema",
          "type": "integer"
        },
        "finding_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Finding Refs",
          "type": "array"
        },
        "kind": {
          "const": "evaluation",
          "title": "Kind",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "complete",
            "incomplete",
            "infeasible",
            "unresolved"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "result_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Result Id",
          "type": "string"
        },
        "scope_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        },
        "trace_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Trace Refs",
          "type": "array"
        },
        "versions": {
          "$ref": "#/$defs/WorldVersions"
        }
      },
      "required": [
        "kind",
        "evidence_schema",
        "context",
        "versions",
        "effective_time",
        "result_id",
        "scope_id",
        "outcome",
        "coverage",
        "finding_refs",
        "trace_refs"
      ],
      "title": "EvaluationSummary",
      "type": "object"
    },
    "EvidenceLinks": {
      "additionalProperties": false,
      "properties": {
        "assumption_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Assumption Refs",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Source Refs",
          "type": "array"
        },
        "trace_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Trace Refs",
          "type": "array"
        }
      },
      "required": [
        "source_refs",
        "assumption_refs",
        "trace_refs"
      ],
      "title": "EvidenceLinks",
      "type": "object"
    },
    "EvidencePageResult": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/RevisionContext"
        },
        "effective_time": {
          "$ref": "#/$defs/EffectiveTime"
        },
        "evidence_schema": {
          "const": 1,
          "title": "Evidence Schema",
          "type": "integer"
        },
        "kind": {
          "const": "evidence_page",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "discriminator": {
            "mapping": {
              "assumptions": "#/$defs/AssumptionPage",
              "findings": "#/$defs/FindingPage",
              "outputs": "#/$defs/OutputPage",
              "sources": "#/$defs/SourcePage",
              "traces": "#/$defs/TracePage"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/OutputPage"
            },
            {
              "$ref": "#/$defs/FindingPage"
            },
            {
              "$ref": "#/$defs/SourcePage"
            },
            {
              "$ref": "#/$defs/AssumptionPage"
            },
            {
              "$ref": "#/$defs/TracePage"
            }
          ],
          "title": "Page"
        },
        "result_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Result Id",
          "type": "string"
        },
        "scope_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        },
        "versions": {
          "$ref": "#/$defs/WorldVersions"
        }
      },
      "required": [
        "kind",
        "evidence_schema",
        "context",
        "versions",
        "effective_time",
        "result_id",
        "scope_id",
        "page"
      ],
      "title": "EvidencePageResult",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "affected_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Affected Refs",
          "type": "array"
        },
        "category": {
          "enum": [
            "physical_shortage",
            "selected_policy_breach",
            "institutional_gap",
            "uncertainty",
            "player_target_observation"
          ],
          "title": "Category",
          "type": "string"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "effective_time": {
          "$ref": "#/$defs/EffectiveTime"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceLinks"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "rule_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rule Ref"
        },
        "scope_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "category",
        "scope_id",
        "effective_time",
        "message",
        "rule_ref",
        "affected_refs",
        "coverage",
        "evidence"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingPage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "maxItems": 100,
          "title": "Items",
          "type": "array"
        },
        "kind": {
          "const": "findings",
          "title": "Kind",
          "type": "string"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        }
      },
      "required": [
        "next_cursor",
        "kind",
        "items"
      ],
      "title": "FindingPage",
      "type": "object"
    },
    "HistoryError": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "enum": [
            "INVALID_REQUEST",
            "ACCESS_DENIED",
            "UNREADABLE_HISTORY",
            "NOT_FOUND",
            "INVALID_EVIDENCE",
            "RESPONSE_TOO_LARGE"
          ],
          "title": "Error",
          "type": "string"
        },
        "history_protocol": {
          "const": 1,
          "title": "History Protocol",
          "type": "integer"
        }
      },
      "required": [
        "history_protocol",
        "error"
      ],
      "title": "HistoryError",
      "type": "object"
    },
    "HistoryRequest": {
      "additionalProperties": false,
      "properties": {
        "collection": {
          "anyOf": [
            {
              "const": "summary",
              "type": "string"
            },
            {
              "enum": [
                "outputs",
                "findings",
                "sources",
                "assumptions",
                "traces"
              ],
              "type": "string"
            }
          ],
          "title": "Collection"
        },
        "context": {
          "$ref": "#/$defs/RevisionContext"
        },
        "history_protocol": {
          "const": 1,
          "title": "History Protocol",
          "type": "integer"
        },
        "limit": {
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "maximum": 100,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "result_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Result Id",
          "type": "string"
        }
      },
      "required": [
        "history_protocol",
        "context",
        "result_id",
        "collection",
        "offset",
        "limit"
      ],
      "title": "HistoryRequest",
      "type": "object"
    },
    "HistoryResult": {
      "additionalProperties": false,
      "properties": {
        "history_protocol": {
          "const": 1,
          "title": "History Protocol",
          "type": "integer"
        },
        "mode": {
          "const": "stored_historical",
          "title": "Mode",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvaluationSummary"
            },
            {
              "$ref": "#/$defs/EvidencePageResult"
            }
          ],
          "title": "Result"
        }
      },
      "required": [
        "history_protocol",
        "mode",
        "result"
      ],
      "title": "HistoryResult",
      "type": "object"
    },
    "KnownObservation": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "known",
          "title": "Status",
          "type": "string"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "label": "#/$defs/LabelValue",
              "quantity": "#/$defs/QuantityValue",
              "reference": "#/$defs/ReferenceValue"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/QuantityValue"
            },
            {
              "$ref": "#/$defs/LabelValue"
            },
            {
              "$ref": "#/$defs/ReferenceValue"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "status",
        "value"
      ],
      "title": "KnownObservation",
      "type": "object"
    },
    "LabelValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "label",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "maxLength": 131072,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "LabelValue",
      "type": "object"
    },
    "OutputPage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/EvaluationOutput"
          },
          "maxItems": 100,
          "title": "Items",
          "type": "array"
        },
        "kind": {
          "const": "outputs",
          "title": "Kind",
          "type": "string"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        }
      },
      "required": [
        "next_cursor",
        "kind",
        "items"
      ],
      "title": "OutputPage",
      "type": "object"
    },
    "PartialObservation": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "partial",
          "title": "Status",
          "type": "string"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "label": "#/$defs/LabelValue",
              "quantity": "#/$defs/QuantityValue",
              "reference": "#/$defs/ReferenceValue",
              "unknown": "#/$defs/UnknownValue"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/QuantityValue"
            },
            {
              "$ref": "#/$defs/UnknownValue"
            },
            {
              "$ref": "#/$defs/LabelValue"
            },
            {
              "$ref": "#/$defs/ReferenceValue"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "status",
        "value"
      ],
      "title": "PartialObservation",
      "type": "object"
    },
    "QuantityValue": {
      "additionalProperties": false,
      "properties": {
        "denominator_scope_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Denominator Scope Id"
        },
        "kind": {
          "const": "quantity",
          "title": "Kind",
          "type": "string"
        },
        "time_basis_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Time Basis Id"
        },
        "unit_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Unit Id",
          "type": "string"
        },
        "value": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value",
        "unit_id",
        "time_basis_id",
        "denominator_scope_id"
      ],
      "title": "QuantityValue",
      "type": "object"
    },
    "ReferenceValue": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "kind": {
          "const": "reference",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "entity_id"
      ],
      "title": "ReferenceValue",
      "type": "object"
    },
    "RevisionContext": {
      "additionalProperties": false,
      "properties": {
        "branch_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Branch Id",
          "type": "string"
        },
        "civilization_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Civilization Id",
          "type": "string"
        },
        "data_store_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Data Store Id",
          "type": "string"
        },
        "revision_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Revision Id",
          "type": "string"
        }
      },
      "required": [
        "data_store_id",
        "civilization_id",
        "branch_id",
        "revision_id"
      ],
      "title": "RevisionContext",
      "type": "object"
    },
    "SourcePage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 100,
          "title": "Items",
          "type": "array"
        },
        "kind": {
          "const": "sources",
          "title": "Kind",
          "type": "string"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        }
      },
      "required": [
        "next_cursor",
        "kind",
        "items"
      ],
      "title": "SourcePage",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "excerpt_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Excerpt Digest",
          "type": "string"
        },
        "historical_status": {
          "enum": [
            "current",
            "amended",
            "superseded",
            "disputed",
            "unknown"
          ],
          "title": "Historical Status",
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
