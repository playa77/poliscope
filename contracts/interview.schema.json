{
  "$defs": {
    "BranchState": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/RevisionContext"
        },
        "forked_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "redo": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Redo",
          "type": "array"
        },
        "revision_contract": {
          "const": 1,
          "title": "Revision Contract",
          "type": "integer"
        },
        "sequence": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "revision_contract",
        "context",
        "name",
        "sequence",
        "redo",
        "forked_from"
      ],
      "title": "BranchState",
      "type": "object"
    },
    "Definition": {
      "additionalProperties": false,
      "properties": {
        "assumption_refs": {
          "items": {
            "maxLength": 256,
            "pattern": "^[a-z][a-z0-9_.-]*:[a-zA-Z0-9_./-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Assumption Refs",
          "type": "array"
        },
        "evidence": {
          "enum": [
            "unreviewed",
            "hypothetical",
            "supported",
            "disputed"
          ],
          "title": "Evidence",
          "type": "string"
        },
        "historical_status": {
          "enum": [
            "adopted",
            "alternative",
            "amended",
            "superseded",
            "provenance",
            "unspecified"
          ],
          "title": "Historical Status",
          "type": "string"
        },
        "id": {
          "maxLength": 256,
          "pattern": "^[a-z][a-z0-9_.-]*:[a-zA-Z0-9_./-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "domain",
            "branch",
            "question",
            "option",
            "mechanism",
            "parameter",
            "measurement",
            "fixture"
          ],
          "title": "Kind",
          "type": "string"
        },
        "measurement": {
          "anyOf": [
            {
              "$ref": "#/$defs/MeasurementDeclaration"
            },
            {
              "type": "null"
            }
