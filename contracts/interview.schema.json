        "parent_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "pattern": "^[a-z][a-z0-9_.-]*:[a-zA-Z0-9_./-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Ref"
        },
        "source_decision_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Decision Id"
        },
        "source_refs": {
          "items": {
            "maxLength": 256,
            "pattern": "^[a-z][a-z0-9_.-]*:[a-zA-Z0-9_./-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Source Refs",
          "type": "array"
        },
        "supersedes_refs": {
          "items": {
            "maxLength": 256,
            "pattern": "^[a-z][a-z0-9_.-]*:[a-zA-Z0-9_./-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Supersedes Refs",
          "type": "array"
        },
        "variable_refs": {
          "items": {
            "maxLength": 256,
            "pattern": "^[a-z][a-z0-9_.-]*:[a-zA-Z0-9_./-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Variable Refs",
          "type": "array"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "kind",
        "parent_ref",
        "original_text",
        "source_decision_id",
        "source_refs",
        "assumption_refs",
        "supersedes_refs",
        "mechanism_refs",
        "variable_refs",
        "origin",
        "modeling",
        "evidence",
        "historical_status"
      ],
      "title": "Definition",
      "type": "object"
    },
    "EffectiveTime": {
      "additionalProperties": false,
      "description": "Simulation time; no wall-clock timestamp participates in this identity.",
      "properties": {
        "calendar_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Calendar Id",
          "type": "string"
        },
        "tick": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        }
      },
      "required": [
        "tick",
        "calendar_id"
      ],
      "title": "EffectiveTime",
      "type": "object"
    },
    "InterviewApply": {
      "additionalProperties": false,
