{
  "$defs": {
    "AudioData": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "maxLength": 90000,
          "minLength": 1,
          "title": "Data",
          "type": "string"
        },
        "format": {
          "const": "wav",
          "title": "Format",
          "type": "string"
        }
      },
      "required": [
        "data",
        "format"
      ],
      "title": "AudioData",
      "type": "object"
    },
    "AudioPart": {
      "additionalProperties": false,
      "properties": {
        "input_audio": {
          "$ref": "#/$defs/AudioData"
        },
        "type": {
          "const": "input_audio",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "input_audio"
      ],
      "title": "AudioPart",
      "type": "object"
    },
    "GenerationCall": {
      "additionalProperties": false,
      "properties": {
        "function": {
          "$ref": "#/$defs/GenerationCallFunction"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,128}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "function",
          "default": "function",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "function"
      ],
      "title": "GenerationCall",
      "type": "object"
    },
    "GenerationCallFunction": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "maxLength": 16384,
          "title": "Arguments",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "title": "GenerationCallFunction",
      "type": "object"
    },
    "GenerationFormat": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "schema_text": {
          "anyOf": [
            {
              "maxLength": 32768,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Text"
        },
        "type": {
          "enum": [
            "text",
            "json_object",
            "json_schema"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "GenerationFormat",
      "type": "object"
    },
    "GenerationMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "anyOf": [
            {
              "maxLength": 262144,
              "minLength": 1,
              "type": "string"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TextPart"
                  },
                  {
                    "$ref": "#/$defs/ImagePart"
                  },
                  {
                    "$ref": "#/$defs/AudioPart"
                  }
                ]
              },
              "maxItems": 5,
              "minItems": 1,
              "type": "array"
            }
          ],
          "title": "Content"
        },
        "reasoning_details_json": {
          "anyOf": [
            {
              "maxLength": 65536,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Details Json"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        },
        "tool_calls": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/GenerationCall"
              },
              "maxItems": 8,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "GenerationMessage",
      "type": "object"
    },
    "GenerationPlan": {
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Expected Revision",
          "type": "integer"
        },
        "generation_contract": {
          "const": 1,
          "title": "Generation Contract",
          "type": "integer"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/GenerationMessage"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Messages",
          "type": "array"
        },
        "output_modalities": {
          "default": [
            "text"
          ],
          "items": {
            "enum": [
              "text",
              "image",
              "audio"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Output Modalities",
          "type": "array"
        },
        "profile_id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Profile Id",
          "type": "string"
        },
        "response_format": {
          "$ref": "#/$defs/GenerationFormat"
        },
        "stream": {
          "title": "Stream",
          "type": "boolean"
        },
        "tool_choice": {
          "default": "auto",
          "maxLength": 64,
          "title": "Tool Choice",
          "type": "string"
        },
        "tools": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GenerationTool"
          },
          "maxItems": 32,
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "generation_contract",
        "profile_id",
        "expected_revision",
        "messages",
        "stream",
        "response_format"
      ],
      "title": "GenerationPlan",
      "type": "object"
    },
    "GenerationResult": {
      "additionalProperties": false,
      "properties": {
        "actual_model": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actual Model"
        },
        "actual_provider": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actual Provider"
        },
        "finish_reason": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finish Reason"
        },
        "generation_contract": {
          "const": 1,
          "title": "Generation Contract",
          "type": "integer"
        },
        "parameter": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameter"
        },
        "selected_model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Selected Model",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "incomplete",
            "refused",
            "structured-invalid",
            "provider-rejected",
            "unsupported-parameter",
            "response-invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 1048576,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text"
        },
        "validated_json": {
          "anyOf": [
            {
              "maxLength": 1048576,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Validated Json"
        }
      },
      "required": [
        "generation_contract",
        "selected_model",
        "actual_model",
        "actual_provider",
        "finish_reason",
        "status",
        "validated_json",
        "text"
      ],
      "title": "GenerationResult",
      "type": "object"
    },
    "GenerationTool": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 4096,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Name",
          "type": "string"
        },
        "parameters_json": {
          "maxLength": 32768,
          "minLength": 2,
          "title": "Parameters Json",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "parameters_json"
      ],
      "title": "GenerationTool",
      "type": "object"
    },
    "ImagePart": {
      "additionalProperties": false,
      "properties": {
        "image_url": {
          "$ref": "#/$defs/ImageURL"
        },
        "type": {
          "const": "image_url",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "image_url"
      ],
      "title": "ImagePart",
      "type": "object"
    },
    "ImageURL": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "const": "low",
          "default": "low",
          "title": "Detail",
          "type": "string"
        },
        "url": {
          "maxLength": 90000,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "ImageURL",
      "type": "object"
    },
    "TextPart": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 262144,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "TextPart",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/GenerationPlan"
    },
    {
      "$ref": "#/$defs/GenerationResult"
    }
  ]
}
