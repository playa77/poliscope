    {
      "area": "classification and source identity",
      "finding": "All twelve current coverage inventories retain the pinned source revision/archive identity. Archived source choices and model activation remain separate."
    },
    {
      "area": "behavioral validity",
      "finding": "Authored finite resource/procedural fixtures are hypothetical educational models, not calibrated universal social effects. Unsupported branches remain visible; sources do not supply automatic civic defaults."
    },
    {
      "area": "definitions and trace closure",
      "finding": "Actual shared conformance, measurements and retained evidence fixtures preserve canonical identities, units/scopes/time, source/assumption descriptors and allocation-supported outputs. Context and source lineage are not inferred from UI values."
    },
    {
      "area": "uncertainty",
      "finding": "Point/range/probability status is explicit; repeated variables and common causes use declared joint models. Missing dependence/propagation remains qualified rather than an independence assumption."
    },
    {
      "area": "activation and attribution",
      "finding": "Pinned corpus/content tests reject missing license/revision, source tampering, unsupported activation and changed reviews. Exact options and supersession are retained, including source document-maintenance provenance."
    },
