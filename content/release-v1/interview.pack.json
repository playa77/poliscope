      "measurement": null,
      "mechanism_refs": [],
      "modeling": "qualitative",
      "origin": "authored",
      "original_text": "Common provision. A common provision process receives requests and assigns access under an explicitly agreed procedure.",
      "parameter": null,
      "parent_ref": "interview:domain-2",
      "source_decision_id": null,
      "source_refs": [
        "interview:source/conventions"
      ],
