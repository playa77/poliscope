      "kind": "option",
      "measurement": null,
      "mechanism_refs": [],
      "modeling": "qualitative",
      "origin": "authored",
      "original_text": "Household provisioning. Households arrange their own material purchases and storage, and record unmet needs locally.",
      "parameter": null,
      "parent_ref": "interview:domain-1",
      "source_decision_id": null,
      "source_refs": [
        "interview:source/conventions"
      ],
      "supersedes_refs": [],
