      "kind": "option",
      "measurement": null,
      "mechanism_refs": [],
      "modeling": "qualitative",
      "origin": "authored",
      "original_text": "Shared provisioning. Participants pool specified material requirements through a shared store with an agreed access procedure.",
      "parameter": null,
      "parent_ref": "interview:domain-1",
      "source_decision_id": null,
      "source_refs": [
        "interview:source/conventions"
      ],
      "supersedes_refs": [],
      "variable_refs": [],
      "version": "v1"
    },
