      "kind": "option",
      "measurement": null,
      "mechanism_refs": [],
      "modeling": "qualitative",
      "origin": "authored",
      "original_text": "Direct exchange. Participants negotiate exchanges directly and specify what happens when someone cannot offer a counterpart.",
      "parameter": null,
      "parent_ref": "interview:domain-2",
      "source_decision_id": null,
      "source_refs": [
