      "measurement": null,
      "mechanism_refs": [],
      "modeling": "qualitative",
      "origin": "authored",
      "original_text": "Mixed provisioning. Household stores coexist with a shared reserve; participants must define when requests cross between them.",
      "parameter": null,
      "parent_ref": "interview:domain-1",
      "source_decision_id": null,
      "source_refs": [
        "interview:source/conventions"
      ],
      "supersedes_refs": [],
