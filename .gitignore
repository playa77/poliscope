# Logs and crash reports
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/logs/
/crash-reports/
*.dmp
*.stackdump

# Local environment configuration: track sanitized templates only
.env
.env.*
!.env.example
!.env.*.example
!.env.template
.python-version.local

# Credentials and release-signing material
/credentials/
/secrets/
/.secrets/
/keys/
*.pem
*.key
*.p12
*.pfx
*.keystore

# Private runtime state and personal exports
/user-data/
/.local/
/runtime/
/saves/
/exports/
/transcripts/
/attachments/
*.society
*.sqlite
*.sqlite3
*.db
*-wal
*-shm
*-journal

# Deliberately tracked, sanitized fixtures may contain portable saves/databases
!**/fixtures/**/*.society
!**/fixtures/**/*.sqlite
!**/fixtures/**/*.sqlite3
!**/fixtures/**/*.db

# Native distribution packages
*.dmg
*.exe
*.msi
*.msix
*.deb
*.rpm
*.AppImage
*.blockmap

