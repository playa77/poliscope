/build/
/release/
/artifacts/
.vite/
.webpack/
*.tsbuildinfo

# Python environments, bytecode, and packaging output
.venv/
venv/
__pycache__/
*.py[cod]
__pypackages__/
*.egg-info/
.eggs/
/engine/build/
/engine/dist/
/engine/wheelhouse/

# Tests, coverage, static analysis, and benchmark caches
.pytest_cache/
.hypothesis/
